# Public build-time configuration; never store secrets here.
# Mocks require DEV plus explicit true. Production ignores this flag.
VITE_USE_MOCKS=false
# Empty = same-origin /api. Dev proxy forwards it to API port 8081.
# Optional public API origin, e.g. https://api.example.com (without /api/v1).
VITE_API_URL=
